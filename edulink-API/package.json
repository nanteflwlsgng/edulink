{
  "name": "edulink-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "node scripts/safe-migration.js && nodemon app.js",
    "start": "node scripts/safe-migration.js && node app.js",
    "migrate:safe": "npx prisma db pull && npx prisma generate && npx prisma migrate status && echo ✅ Migrations vérifiées || npx prisma db push --accept-data-loss && echo ✅ Base synchronisée",
    "migrate:new": "npm run migrate:safe && npx prisma migrate dev --name",
    "db:status": "npx prisma migrate status",
    "db:pull": "npx prisma db pull",
    "db:push": "npx prisma db push --accept-data-loss"
  },
